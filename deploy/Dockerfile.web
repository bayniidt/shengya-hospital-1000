FROM dockerproxy.net/library/node:24.14.0-bookworm-slim AS dependencies

WORKDIR /app
COPY web/package.json web/package-lock.json ./
RUN npm ci --no-audit --no-fund

FROM dockerproxy.net/library/node:24.14.0-bookworm-slim AS builder

WORKDIR /app
COPY --from=dependencies /app/node_modules ./node_modules
COPY web/ ./
COPY deploy/layout.demo.tsx ./src/app/layout.tsx
COPY deploy/demo-fonts.css ./src/app/demo-fonts.css
COPY deploy/next.config.demo.ts ./next.config.ts
ENV NODE_ENV=production
ENV NEXT_TELEMETRY_DISABLED=1
ENV NEXT_PUBLIC_BASE_PATH=/shengya-demo
RUN npm run build -- --webpack

FROM dockerproxy.net/library/node:24.14.0-bookworm-slim AS runner

WORKDIR /app
ENV NODE_ENV=production
ENV NEXT_TELEMETRY_DISABLED=1
ENV PORT=3000
ENV HOSTNAME=0.0.0.0
COPY --from=builder --chown=node:node /app/public ./public
COPY --from=builder --chown=node:node /app/.next/standalone ./
COPY --from=builder --chown=node:node /app/.next/static ./.next/static
USER node
EXPOSE 3000
CMD ["node", "server.js"]
